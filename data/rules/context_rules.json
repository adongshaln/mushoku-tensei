    {"id": "church_suspicion", "label": "教会的外貌戒心", "category": "种族", "value": -2, "tags": ["source:ancestry"], "suppressible_by": ["mask:race_appearance", "override:stranger_distrust"], "conditions": {"actor_tags_all": ["race:migurd"], "context_tags_all": ["intent:persuade", "faction:millis_church"]}},
