config_version=5

[application]

config/name="无职转生～属于你自己的人生"
run/main_scene="res://scenes/title/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

WorldBlackboard="*res://core/world_blackboard.gd"
RuleEngine="*res://core/rule_engine.gd"
AudioBusManager="*res://resources/audio/audio_bus_manager.gd"
AudioManager="*res://core/audio_manager.gd"
SettingsManager="*res://core/settings_manager.gd"
SceneTransition="*res://scenes/shared/scene_transition.gd"
StatChangeBanner="*res://ui/stat_change_banner.gd"
StoryletScheduler="*res://core/storylet_scheduler.gd"
SaveManager="*res://core/save_manager.gd"
EconomyManager="*res://core/economy_manager.gd"
JournalManager="*res://core/journal_manager.gd"
JournalUI="*res://ui/journal_ui.gd"

[audio]

buses/default_bus_layout="res://resources/audio/game_bus_layout.tres"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.19, 0.16, 0.12, 1)
